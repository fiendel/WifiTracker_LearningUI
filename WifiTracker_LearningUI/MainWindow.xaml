<Window x:Class="WifiRadar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WiFi Presence Radar"
        Height="520"
        Width="900"
        Background="#0B0F14">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL -->
        <Grid Grid.Column="0">

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <TextBlock Name="StatusText"
                           Text="CALIBRATING..."
                           Foreground="Orange"
                           FontSize="26"
                           FontWeight="Bold"
                           TextAlignment="Center"/>

                <TextBlock Name="DebugText"
                           Foreground="#88FFFFFF"
                           FontSize="12"
                           Margin="0,10,0,0"
                           TextAlignment="Center"/>

            </StackPanel>

        </Grid>

        <!-- RIGHT CONTROL PANEL -->
        <Border Grid.Column="1"
                Background="#111823"
                Padding="12"
                CornerRadius="10"
                Margin="10">

            <StackPanel>

                <TextBlock Text="CONTROL PANEL"
                           Foreground="#00FF99"
                           FontSize="16"
                           FontWeight="Bold"/>

                <!-- CALIBRATE -->
                <Button Content="Auto Calibrate"
                        Margin="0,10,0,10"
                        Click="AutoCalibrate_Click"
                        Background="#1A2A33"
                        Foreground="White"/>

                <!-- SENSITIVITY -->
                <TextBlock Text="Sensitivity"
                           Foreground="White"/>

                <Slider Name="SensitivitySlider"
                        Minimum="0"
                        Maximum="10"
                        Value="2.5"
                        Height="18"
                        Margin="0,5,0,10">

                    <Slider.Resources>
                        <Style TargetType="Thumb">
                            <Setter Property="Width" Value="14"/>
                            <Setter Property="Height" Value="14"/>
                            <Setter Property="Background" Value="#00FF99"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Thumb">
                                        <Ellipse Fill="{TemplateBinding Background}"
                                                 Stroke="#AA00FF99"
                                                 StrokeThickness="2"/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Slider.Resources>

                </Slider>

                <!-- FINE TUNE -->
                <TextBlock Text="Fine Tune"
                           Foreground="White"
                           Margin="0,10,0,0"/>

                <Slider Name="FineTuneSlider"
                        Minimum="-5"
                        Maximum="5"
                        Value="0"
                        Height="18"
                        Margin="0,5,0,10">

                    <Slider.Resources>
                        <Style TargetType="Thumb">
                            <Setter Property="Width" Value="14"/>
                            <Setter Property="Height" Value="14"/>
                            <Setter Property="Background" Value="#00AFFF"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Thumb">
                                        <Ellipse Fill="{TemplateBinding Background}"
                                                 Stroke="#AA00AFFF"
                                                 StrokeThickness="2"/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Slider.Resources>

                </Slider>

                <TextBlock Text="LIVE"
                           Foreground="#00FF99"
                           Margin="0,15,0,5"/>

                <TextBlock Name="ParamsText"
                           Foreground="#CCCCCC"
                           FontSize="12"
                           TextWrapping="Wrap"/>

            </StackPanel>

        </Border>

    </Grid>
</Window>